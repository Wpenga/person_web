{
  "version": 2,
  "name": "personal-portfolio",
  "scope": "yourusername",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "rootDirectory": "wpenga-portfolio",
  "env": {
    "NODE_ENV": "production"
  },
  "regions": ["hkg1"],
  "alias": ["yourname.vercel.app"],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
